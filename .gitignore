node_modules/
release/
release-mac/
# vendor (в т.ч. приватный vendor/nomad-src — код агента) вшивается фетчером
# на сборке (tools/fetch-vendor*); в git НЕ коммитим — КРОМЕ архива курса.
# vendor/* (содержимое), чтобы git заходил внутрь и мог re-include course ниже.
vendor/*
# Исключение: курс-симулятор (лёгкий ~275КБ) трекается в git — раздаётся всем бесплатно.
!vendor/course/
*.log
*.dmg
*.exe
__pycache__/
*.pyc
Microsoft/

# Рабочие бэкапы, которые роботы и скрипты кладут прямо в дерево репозитория
# (_bak-w3-errors-20260820T072153/ и подобные). Отдельным правилом, потому что один
# такой каталог уже висел в untracked и напрашивался попасть в коммит скопом:
# `git add -A` при живом рое однажды уже утащил 1900 строк чужой незавершённой работы.
# Игнорируем КЛАСС, а не конкретный каталог — следующий будет называться иначе.
_bak-*/
*.hm-bak
*.bak-[0-9]*

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Секреты и ключи (S-10): репозиторий ПУБЛИЧНЫЙ, и «git add -A» не должен уметь их подхватить. Сертификат
# подписи Windows облачный (файла .pfx у него нет), но .env, ключи и сертификаты появляются у соавторов,
# в CI и при перевыпусках. Это последняя страховка поверх tools/assert-clean.js, а не замена ему.
# Шаблоны .env.example в templates/ остаются в репозитории.
.env*
!.env.example
*.pfx
*.p12
*.p8
*.pem
*.key
# Временный набор vendor, который tools/build-lite.js собирает для lite-издания и убирает в finally.
vendor-lite/

# Личные паттерны экспорт-фильтра nomad-src (имя владельца, его адреса и домены): ЛОКАЛЬНЫЙ файл на машине сборки.
# Репозиторий публичный, поэтому значения в нём лежать не должны (tools/fetch-vendor*.{ps1,sh}: Get-HmLeakPatterns / leak_patterns_load).
tools/leak-patterns.local.json
